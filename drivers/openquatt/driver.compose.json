{
  "name": {
    "en": "OpenQuatt Controller",
    "nl": "OpenQuatt Controller"
  },
  "class": "thermostat",
  "capabilities": [
    "measure_temperature.supply",
    "measure_temperature.return",
    "measure_temperature.outside",
    "measure_temperature.room",
    "measure_temperature.setpoint",
    "measure_temperature.dew_point",
    "measure_power",
    "oq_heat_power",
    "oq_cool_power",
    "oq_cop",
    "oq_eer",
    "oq_flow",
    "oq_control_mode",
    "oq_control_mode_number",
    "oq_aux_function",
    "oq_aux_status",
    "oq_heating_permitted",
    "oq_cooling_permitted",
    "onoff.openquatt",
    "onoff.cooling",
    "onoff.aux_relay"
  ],
  "capabilitiesOptions": {
    "measure_temperature.supply": {
      "title": {
        "en": "Supply temperature",
        "nl": "Aanvoertemperatuur"
      }
    },
    "measure_temperature.return": {
      "title": {
        "en": "Return temperature",
        "nl": "Retourtemperatuur"
      }
    },
    "measure_temperature.outside": {
      "title": {
        "en": "Outside temperature",
        "nl": "Buitentemperatuur"
      }
    },
    "measure_temperature.room": {
      "title": {
        "en": "Room temperature",
        "nl": "Kamertemperatuur"
      }
    },
    "measure_temperature.setpoint": {
      "title": {
        "en": "Room setpoint",
        "nl": "Kamersetpoint"
      }
    },
    "measure_temperature.dew_point": {
      "title": {
        "en": "Dew point",
        "nl": "Dauwpunt"
      }
    },
    "oq_control_mode_number": {
      "uiComponent": null
    },
    "onoff.openquatt": {
      "title": {
        "en": "OpenQuatt control",
        "nl": "OpenQuatt-regeling"
      },
      "insightsTitleTrue": {
        "en": "OpenQuatt control on",
        "nl": "OpenQuatt-regeling aan"
      },
      "insightsTitleFalse": {
        "en": "OpenQuatt control off",
        "nl": "OpenQuatt-regeling uit"
      }
    },
    "onoff.cooling": {
      "title": {
        "en": "Manual cooling enable",
        "nl": "Handmatige koelvrijgave"
      },
      "insightsTitleTrue": {
        "en": "Cooling enabled",
        "nl": "Koelvrijgave aan"
      },
      "insightsTitleFalse": {
        "en": "Cooling disabled",
        "nl": "Koelvrijgave uit"
      }
    },
    "onoff.aux_relay": {
      "title": {
        "en": "Aux relay (R2)",
        "nl": "Hulprelais (R2)"
      },
      "insightsTitleTrue": {
        "en": "Aux relay on",
        "nl": "Hulprelais aan"
      },
      "insightsTitleFalse": {
        "en": "Aux relay off",
        "nl": "Hulprelais uit"
      }
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "discovery": "esphome",
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "address",
      "type": "text",
      "label": {
        "en": "Host / IP override",
        "nl": "Host / IP-adres (handmatig)"
      },
      "value": "",
      "hint": {
        "en": "Leave empty to use the address found via network discovery.",
        "nl": "Laat leeg om het adres van de netwerk-discovery te gebruiken."
      }
    },
    {
      "type": "group",
      "label": {
        "en": "External values",
        "nl": "Externe waarden"
      },
      "children": [
        {
          "id": "dew_point_max_age",
          "type": "number",
          "label": {
            "en": "Maximum sensor value age (minutes)",
            "nl": "Maximale leeftijd sensorwaarde (minuten)"
          },
          "value": 60,
          "min": 5,
          "max": 180,
          "hint": {
            "en": "Measurements the flows stop refreshing within this window are no longer sent to the controller, which then falls back to its own source. Applies to the dew point (per room) and to the outside and room temperature; the room setpoint and heating permission stand until you send a new value.",
            "nl": "Meetwaarden die de flows binnen deze periode niet vernieuwen, gaan niet meer naar de controller; die valt dan terug op zijn eigen bron. Geldt voor het dauwpunt (per ruimte) en voor de buiten- en kamertemperatuur; het kamer-setpoint en de warmtetoestemming blijven staan tot je een nieuwe waarde stuurt."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "External values — MQTT fallback",
        "nl": "Externe waarden — MQTT-fallback"
      },
      "children": [
        {
          "id": "mqtt_host",
          "type": "text",
          "label": {
            "en": "MQTT broker host",
            "nl": "MQTT-broker host"
          },
          "value": "",
          "hint": {
            "en": "Only needed on firmware without API input support: values are normally sent straight to the controller. As fallback, fill in the broker that is configured as MQTT input source in the OpenQuatt web app (Settings → Sources / integrations).",
            "nl": "Alleen nodig op firmware zonder API-invoer: waarden gaan normaal rechtstreeks naar de controller. Vul als fallback de broker in die als MQTT-inputbron is ingesteld in de OpenQuatt web-app (Instellingen → Bronnen / integraties)."
          }
        },
        {
          "id": "mqtt_port",
          "type": "number",
          "label": {
            "en": "MQTT broker port",
            "nl": "MQTT-broker poort"
          },
          "value": 1883,
          "min": 1,
          "max": 65535
        },
        {
          "id": "mqtt_username",
          "type": "text",
          "label": {
            "en": "MQTT username",
            "nl": "MQTT-gebruikersnaam"
          },
          "value": ""
        },
        {
          "id": "mqtt_password",
          "type": "password",
          "label": {
            "en": "MQTT password",
            "nl": "MQTT-wachtwoord"
          },
          "value": ""
        },
        {
          "id": "mqtt_device_name",
          "type": "text",
          "label": {
            "en": "Controller device name",
            "nl": "Apparaatnaam van de controller"
          },
          "value": "openquatt",
          "hint": {
            "en": "Used in the MQTT topics openquatt/<name>/input/…. Check the exact topics under MQTT sensors → Details in the OpenQuatt web app.",
            "nl": "Wordt gebruikt in de MQTT-topics openquatt/<naam>/input/…. Controleer de exacte topics onder MQTT-sensoren → Details in de OpenQuatt web-app."
          }
        }
      ]
    }
  ]
}
