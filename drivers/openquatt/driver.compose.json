  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "discovery": "esphome",
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "settings": [
    {
      "id": "address",
      "type": "text",
      "label": {
        "en": "Host / IP override",
        "nl": "Host / IP-adres (handmatig)"
      },
      "value": "",
      "hint": {
        "en": "Leave empty to use the address found via network discovery.",
        "nl": "Laat leeg om het adres van de netwerk-discovery te gebruiken."
      }
    },
    {
      "type": "group",
      "label": {
        "en": "Controller login",
        "nl": "Login van de controller"
      },
      "children": [
        {
          "id": "web_username",
          "type": "text",
          "label": {
            "en": "Username",
            "nl": "Gebruikersnaam"
          },
          "value": "",
          "hint": {
            "en": "The login the OpenQuatt web app asks for, if you set one on the controller. Remote access below needs a login too: without one on the controller, what you fill in here only guards the remote page.",
            "nl": "De login waar de OpenQuatt web-app om vraagt, als je die op de controller hebt ingesteld. Toegang op afstand hieronder heeft ook een login nodig: zonder login op de controller beschermt wat je hier invult alleen de pagina op afstand."
          }
        },
        {
          "id": "web_password",
          "type": "password",
          "label": {
            "en": "Password",
            "nl": "Wachtwoord"
          },
          "value": ""
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "External values",
        "nl": "Externe waarden"
      },
      "children": [
        {
          "id": "dew_point_max_age",
          "type": "number",
          "label": {
            "en": "Maximum sensor value age (minutes)",
            "nl": "Maximale leeftijd sensorwaarde (minuten)"
          },
          "value": 60,
          "min": 5,
          "max": 180,
          "hint": {
            "en": "Measurements the flows stop refreshing within this window are no longer sent to the controller, which then falls back to its own source. Applies to the dew point (per room) and to the outside and room temperature; the room setpoint and heating permission stand until you send a new value.",
            "nl": "Meetwaarden die de flows binnen deze periode niet vernieuwen, gaan niet meer naar de controller; die valt dan terug op zijn eigen bron. Geldt voor het dauwpunt (per ruimte) en voor de buiten- en kamertemperatuur; het kamer-setpoint en de warmtetoestemming blijven staan tot je een nieuwe waarde stuurt."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "External values — MQTT fallback",
        "nl": "Externe waarden — MQTT-fallback"
      },
      "children": [
        {
          "id": "mqtt_host",
          "type": "text",
          "label": {
            "en": "MQTT broker host",
            "nl": "MQTT-broker host"
          },
          "value": "",
          "hint": {
            "en": "Only needed on firmware without API input support: values are normally sent straight to the controller. As fallback, fill in the broker that is configured as MQTT input source in the OpenQuatt web app (Settings → Sources / integrations).",
            "nl": "Alleen nodig op firmware zonder API-invoer: waarden gaan normaal rechtstreeks naar de controller. Vul als fallback de broker in die als MQTT-inputbron is ingesteld in de OpenQuatt web-app (Instellingen → Bronnen / integraties)."
          }
        },
        {
          "id": "mqtt_port",
          "type": "number",
          "label": {
            "en": "MQTT broker port",
            "nl": "MQTT-broker poort"
          },
          "value": 1883,
          "min": 1,
          "max": 65535
        },
        {
          "id": "mqtt_username",
          "type": "text",
          "label": {
            "en": "MQTT username",
            "nl": "MQTT-gebruikersnaam"
          },
          "value": ""
        },
        {
          "id": "mqtt_password",
          "type": "password",
          "label": {
            "en": "MQTT password",
            "nl": "MQTT-wachtwoord"
          },
          "value": ""
        },
        {
          "id": "mqtt_device_name",
          "type": "text",
          "label": {
            "en": "Controller device name",
            "nl": "Apparaatnaam van de controller"
          },
          "value": "openquatt",
          "hint": {
            "en": "Used in the MQTT topics openquatt/<name>/input/…. Check the exact topics under MQTT sensors → Details in the OpenQuatt web app.",
            "nl": "Wordt gebruikt in de MQTT-topics openquatt/<naam>/input/…. Controleer de exacte topics onder MQTT-sensoren → Details in de OpenQuatt web-app."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Remote access",
        "nl": "Toegang op afstand"
      },
      "children": [
        {
          "id": "remote_enabled",
          "type": "checkbox",
          "label": {
            "en": "View the controller from outside the home",
            "nl": "Controller bekijken buiten de deur"
          },
          "value": false,
          "hint": {
            "en": "Lets the page below show the controller from anywhere, read-only, through your Homey's cloud connection. You sign in there with the login above, which needs a password of at least 8 characters. Turning this off or changing the password signs everyone out.",
            "nl": "Laat de pagina hieronder de controller overal tonen (alleen bekijken, niet bedienen), via de cloudverbinding van je Homey. Je logt daar in met de login hierboven; die heeft een wachtwoord van minstens 8 tekens nodig. Uitzetten of het wachtwoord wijzigen meldt iedereen af."
          }
        },
        {
          "id": "remote_link",
          "type": "label",
          "label": {
            "en": "Page",
            "nl": "Pagina"
          },
          "value": "",
          "hint": {
            "en": "Open this address in a browser. It contains your Homey's id, so the page knows which Homey to call.",
            "nl": "Open dit adres in een browser. Het bevat het id van je Homey, zodat de pagina weet welke Homey hij moet aanroepen."
          }
        }
      ]
    }
  ]
}
