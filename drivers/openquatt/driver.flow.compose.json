    {
      "id": "dew_point_is_available",
      "title": {
        "en": "A dew point is !{{available|not available}}",
        "nl": "Er is !{{een|geen}} dauwpunt beschikbaar"
      }
    },
    {
      "id": "cooling_is_permitted",
      "title": {
        "en": "Cooling is !{{permitted|not permitted}}",
        "nl": "Koelen is !{{toegestaan|niet toegestaan}}"
      }
    },
    {
      "id": "aux_function_is",
      "title": {
        "en": "Aux relay function !{{is|is not}}",
        "nl": "Hulprelais-functie !{{is|is niet}}"
