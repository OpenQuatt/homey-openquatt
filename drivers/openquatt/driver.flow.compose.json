{
  "triggers": [
    {
      "id": "control_mode_changed",
      "title": {
        "en": "The control mode changed",
        "nl": "De regelmodus is veranderd"
      },
      "tokens": [
        {
          "name": "mode",
          "type": "string",
          "title": {
            "en": "Mode",
            "nl": "Modus"
          },
          "example": "CM5"
        }
      ]
    },
    {
      "id": "cooling_started",
      "title": {
        "en": "Cooling started",
        "nl": "Koelen is gestart"
      }
    },
    {
      "id": "cooling_stopped",
      "title": {
        "en": "Cooling stopped",
        "nl": "Koelen is gestopt"
      }
    },
    {
      "id": "heating_started",
      "title": {
        "en": "Heating started",
        "nl": "Verwarmen is gestart"
      }
    },
    {
      "id": "heating_stopped",
      "title": {
        "en": "Heating stopped",
        "nl": "Verwarmen is gestopt"
      }
    },
    {
      "id": "fault_detected",
      "title": {
        "en": "A fault was detected",
        "nl": "Er is een storing gedetecteerd"
      },
      "tokens": [
        {
          "name": "fault",
          "type": "string",
          "title": {
            "en": "Fault",
            "nl": "Storing"
          },
          "example": {
            "en": "Low flow — protection active",
            "nl": "Lage doorstroming — beveiliging actief"
          }
        }
      ]
    },
    {
      "id": "fault_resolved",
      "title": {
        "en": "The fault was resolved",
        "nl": "De storing is opgelost"
      }
    },
    {
      "id": "defrost_started",
      "title": {
        "en": "Defrosting started",
        "nl": "Ontdooien is gestart"
      },
      "tokens": [
        {
          "name": "heatpump",
          "type": "string",
          "title": {
            "en": "Heat pump",
            "nl": "Warmtepomp"
          },
          "example": "HP1"
        }
      ]
    },
    {
      "id": "defrost_stopped",
      "title": {
        "en": "Defrosting stopped",
        "nl": "Ontdooien is gestopt"
      },
      "tokens": [
        {
          "name": "heatpump",
          "type": "string",
          "title": {
            "en": "Heat pump",
            "nl": "Warmtepomp"
          },
          "example": "HP1"
        }
      ]
    },
    {
      "id": "boiler_started",
      "title": {
        "en": "The boiler turned on",
        "nl": "De CV-ketel is ingeschakeld"
      }
    },
    {
      "id": "boiler_stopped",
      "title": {
        "en": "The boiler turned off",
        "nl": "De CV-ketel is uitgeschakeld"
      }
    },
    {
      "id": "silent_started",
      "title": {
        "en": "Silent mode turned on",
        "nl": "Stille modus is ingeschakeld"
      }
    },
    {
      "id": "silent_stopped",
      "title": {
        "en": "Silent mode turned off",
        "nl": "Stille modus is uitgeschakeld"
      }
    },
    {
      "id": "dew_point_available",
      "title": {
        "en": "The dew point became available",
        "nl": "Het dauwpunt is beschikbaar gekomen"
      }
    },
    {
      "id": "dew_point_lost",
      "title": {
        "en": "The dew point was lost",
        "nl": "Het dauwpunt is weggevallen"
      },
      "hint": {
        "en": "Without a valid dew point the controller blocks or limits cooling, depending on its configuration.",
        "nl": "Zonder geldig dauwpunt blokkeert of beperkt de controller het koelen, afhankelijk van de instellingen."
      }
    }
  ],
  "conditions": [
    {
      "id": "is_cooling",
      "title": {
        "en": "Is !{{cooling|not cooling}}",
        "nl": "Is !{{aan het koelen|niet aan het koelen}}"
      }
    },
    {
      "id": "is_heating",
      "title": {
        "en": "Is !{{heating|not heating}}",
        "nl": "Is !{{aan het verwarmen|niet aan het verwarmen}}"
      }
    },
    {
      "id": "has_fault",
      "title": {
        "en": "A fault is !{{active|not active}}",
        "nl": "Er is !{{een storing|geen storing}} actief"
      }
    },
    {
      "id": "is_defrosting",
      "title": {
        "en": "Is !{{defrosting|not defrosting}}",
        "nl": "Is !{{aan het ontdooien|niet aan het ontdooien}}"
      }
    },
    {
      "id": "boiler_is_active",
