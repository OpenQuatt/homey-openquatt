  "actions": [
    {
      "id": "set_silent_override",
      "title": {
        "en": "Set silent mode override",
        "nl": "Zet stille-modus-override"
      },
      "titleFormatted": {
        "en": "Set silent mode override to [[mode]]",
        "nl": "Zet stille-modus-override op [[mode]]"
      },
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            {
              "id": "schedule",
              "label": {
                "en": "Follow schedule",
                "nl": "Volgens schema"
              }
            },
            {
              "id": "on",
              "label": {
                "en": "On",
                "nl": "Aan"
              }
            },
            {
              "id": "off",
              "label": {
                "en": "Off",
                "nl": "Uit"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "force_control_mode",
      "title": {
        "en": "Force control mode",
        "nl": "Forceer regelmodus"
      },
      "titleFormatted": {
        "en": "Force control mode [[mode]]",
        "nl": "Forceer regelmodus [[mode]]"
      },
      "hint": {
        "en": "A forced mode blocks normal heating and cooling until you switch back to Automatic.",
        "nl": "Een geforceerde modus blokkeert normaal verwarmen en koelen totdat je terugschakelt naar Automatisch."
      },
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            {
              "id": "auto",
              "label": {
                "en": "Automatic",
                "nl": "Automatisch"
              }
            },
            {
              "id": "cm0",
              "label": {
                "en": "Standby (CM0)",
                "nl": "Standby (CM0)"
              }
            },
            {
              "id": "cm1",
              "label": {
                "en": "Circulate (CM1)",
                "nl": "Doorstromen (CM1)"
              }
            },
            {
              "id": "cm98",
              "label": {
                "en": "Anti-freeze (CM98)",
                "nl": "Antivries (CM98)"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set_boiler_assist",
      "title": {
        "en": "Set boiler assist",
        "nl": "Zet CV-ketel-assist"
      },
      "titleFormatted": {
        "en": "Set boiler assist [[state]]",
        "nl": "Zet CV-ketel-assist [[state]]"
      },
      "hint": {
        "en": "Turning this off also disables the boiler fallback on heat-pump faults.",
        "nl": "Uitschakelen zet ook de ketel-fallback bij warmtepompstoringen uit."
      },
      "args": [
        {
          "name": "state",
          "type": "dropdown",
          "values": [
            {
              "id": "on",
              "label": {
                "en": "On",
                "nl": "Aan"
              }
            },
            {
              "id": "off",
              "label": {
                "en": "Off",
                "nl": "Uit"
              }
            }
          ]
        }
      ]
    },
