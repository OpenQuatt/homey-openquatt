    {
      "id": "dew_point_available",
      "title": {
        "en": "The dew point became available",
        "nl": "Het dauwpunt is beschikbaar gekomen"
      }
    },
    {
      "id": "dew_point_lost",
      "title": {
        "en": "The dew point was lost",
        "nl": "Het dauwpunt is weggevallen"
