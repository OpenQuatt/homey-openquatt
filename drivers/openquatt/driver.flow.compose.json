      "titleFormatted": {
        "en": "Set boiler assist [[state]]",
        "nl": "Zet CV-ketel-assist [[state]]"
      },
      "hint": {
        "en": "Turning this off also disables the boiler fallback on heat-pump faults.",
        "nl": "Uitschakelen zet ook de ketel-fallback bij warmtepompstoringen uit."
