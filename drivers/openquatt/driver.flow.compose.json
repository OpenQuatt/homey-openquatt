            "en": "Low flow — protection active",
            "nl": "Lage doorstroming — beveiliging actief"
          }
        }
      ]
    },
    {
      "id": "fault_resolved",
      "title": {
        "en": "The fault was resolved",
        "nl": "De storing is opgelost"
      }
    },
    {
      "id": "defrost_started",
      "title": {
        "en": "Defrosting started",
        "nl": "Ontdooien is gestart"
