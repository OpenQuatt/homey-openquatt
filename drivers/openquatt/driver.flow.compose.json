      "titleFormatted": {
        "en": "Aux relay function !{{is|is not}} [[mode]]",
        "nl": "Hulprelais-functie !{{is|is niet}} [[mode]]"
      },
      "args": [
        {
          "name": "mode",
          "type": "dropdown",
          "values": [
            {
              "id": "disabled",
              "label": {
                "en": "Disabled",
                "nl": "Uitgeschakeld"
              }
            },
            {
              "id": "heating",
              "label": {
