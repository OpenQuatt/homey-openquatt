  "flow": {
    "triggers": [
      {
        "id": "control_mode_changed",
        "title": {
          "en": "The control mode changed",
          "nl": "De regelmodus is veranderd"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode",
              "nl": "Modus"
            },
            "example": "CM5"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=openquatt"
          }
        ]
      },
      {
        "id": "cooling_started",
        "title": {
          "en": "Cooling started",
          "nl": "Koelen is gestart"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=openquatt"
          }
        ]
      },
      {
        "id": "cooling_stopped",
        "title": {
          "en": "Cooling stopped",
          "nl": "Koelen is gestopt"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=openquatt"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_cooling",
        "title": {
          "en": "Is !{{cooling|not cooling}}",
          "nl": "Is !{{aan het koelen|niet aan het koelen}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=openquatt"
          }
        ]
      },
      {
        "id": "is_heating",
        "title": {
          "en": "Is !{{heating|not heating}}",
          "nl": "Is !{{aan het verwarmen|niet aan het verwarmen}}"
