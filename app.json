        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=openquatt"
          }
        ]
      },
      {
        "id": "aux_function_is",
        "title": {
          "en": "Aux relay function !{{is|is not}}",
          "nl": "Hulprelais-functie !{{is|is niet}}"
        },
        "titleFormatted": {
          "en": "Aux relay function !{{is|is not}} [[mode]]",
          "nl": "Hulprelais-functie !{{is|is niet}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
